generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
}

// ─── ENUMS ──────────────────────────────

enum Role {
  GUEST
  USER
  PARTNER
  MANAGER
  ADMIN
}

enum EntityType {
  INDIVIDUAL
  INDIVIDUAL_PARTNER
  LEGAL_ENTITY
  LEGAL_PARTNER
}

enum BookingStatus {
  PENDING_REVIEW
  WAIT_PAYMENT
  READY_TO_RENT
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum EquipmentStatus {
  AVAILABLE
  RENTED
  RESERVED
  MAINTENANCE
  BROKEN
  RETIRED
}

enum OwnershipType {
  INTERNAL
  SUBLEASE
}

enum DiscountType {
  PERCENT
  FIXED
  PROMO
}

enum ApplicationStatus {
  LOADING
  NO_APPLICATION
  DRAFT
  PENDING
  REVIEWING
  CLARIFICATION
  STANDARD
  APPROVED
  REJECTED
  BLOCKED
}

enum HistoryAction {
  CREATED
  UPDATED
  DELETED
}

enum CategoryEntityType {
  CATEGORY
  SUBCATEGORY
}

enum DocumentTemplateType {
  CONTRACT_INDIVIDUAL   // Договор для физ. лица
  CONTRACT_LEGAL        // Договор для юр. лица
  ACT                   // Акт выполненных работ
  INVOICE               // Счёт на оплату
  RECEIPT               // Квитанция
  CUSTOM                // Произвольный
}

enum BalanceTxType {
  REFUND
  CREDIT
  DEBIT
  MANUAL
}

enum PaymentMethod {
  CASH        // Наличные
  CARD        // Карта / терминал
  TRANSFER    // Банковский перевод
  BALANCE     // Списание с баланса клиента
  OTHER       // Иное
}

enum PaymentType {
  PAYMENT    // оплата аренды 
  DEPOSIT    // залог
  OTHER      // прочее
}

enum SupportPlatform {
  WEBSITE
  PHONE
  TELEGRAM
  EMAIL
}

enum SupportThreadStatus {
  OPEN
  CLOSED
  WAITING_FOR_ADMIN
  WAITING_FOR_CLIENT
}


// ─── NEXTAUTH & PROFILES ───

model User {
  id                         String                  @id @default(uuid())
  name                       String?
  email                      String?                 @unique
  emailVerified              DateTime?
  image                      String?
  password                   String?    
  role                       Role                    @default(USER)
  entityType                 EntityType?             @default(INDIVIDUAL)
  companyName                String?
  tin                        String?
  isVerified                 Boolean?                @default(false)
  phone                      String?
  extraPhone                 String?
  registrationStep           Int                     @default(1)
  nickname                   String?
  isBlocked                  Boolean                 @default(false)
  blockedReason              String?                 @db.Text
  permissions                Json                    @default("{}")
  deletionScheduledAt        DateTime?
  createdAt                  DateTime                @default(now())
  balance                    Float                   @default(0)
  isAdminCreated             Boolean                 @default(false)
  adminCreatedNote           String?                 @db.Text
  mergedIntoId               String?
  mergedInto                 User?                   @relation("UserMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom                 User[]                  @relation("UserMerge")
  inviteTokens               InviteToken[]
  accounts                   Account[]
  sessions                   Session[]
  bookings                   Booking[]
  cartItems                  CartItem[]
  favorites                  Favorite[]
  equipmentSets              EquipmentSet[]
  clientApplication          ClientApplication?
  adminNotifications         AdminNotification[]
  categoryHistory            CategoryHistory[]
  userDiscounts              UserDiscount[]            @relation("DiscountUser")
  createdDiscounts           UserDiscount[]            @relation("DiscountCreator")
  faqCreated                 FaqItem[]                 @relation("FaqCreator")
  faqUpdated                 FaqItem[]                 @relation("FaqUpdater")
  notesReceived              UserAdminNote[]           @relation("NoteTarget")
  notesWritten               UserAdminNote[]           @relation("NoteAuthor")
  bannersCreated             Banner[]                  @relation("BannerCreator")
  balanceTransactions        BalanceTransaction[]      @relation("UserBalance")
  balanceTxAuthored          BalanceTransaction[]      @relation("TxAuthor")
  bookingAuditLogs           BookingAuditLog[]         @relation("AuditAuthor")
  bookingLabels              BookingLabel[]            @relation("LabelAuthor")
  documentGenerationLogs     DocumentGenerationLog[]   @relation("DocGenAuthor")
  documentTemplates          DocumentTemplate[]        @relation("TemplateCreator")
  bookingPaymentsAuthored    BookingPayment[]          @relation("PaymentAuthor")
  auditLogsReceived          UserAuditLog[]            @relation("UserAuditTarget")
  auditLogsAuthored          UserAuditLog[]            @relation("UserAuditAuthor")
  bookingAdminNotes          BookingAdminNote[]        @relation("BookingNoteAuthor")
  studioBookings             StudioBooking[]
  studioPaymentsAuthored     StudioBookingPayment[]    @relation("StudioPaymentAuthor")
  studioAuditLogsAuthored    StudioBookingAuditLog[]   @relation("StudioAuditAuthor")
  createdPromoCodes          PromoCode[]               @relation("PromoCreator")
  autoPromoCode              String?                   // код авто-промокода при одобрении анкеты

  supportThreads             SupportThread[]
  sentSupportMessages        SupportMessage[]          @relation("SupportMessageAuthor")
  readSupportMessages        SupportMessageRead[]      @relation("SupportMessageReader")
}

model UserAuditLog {
  id           String   @id @default(uuid())
  targetUserId String
  authorId     String?
  authorName   String?
  action       String
  fieldName    String?
  valueBefore  String?  @db.Text
  valueAfter   String?  @db.Text
  meta         Json?
  createdAt    DateTime @default(now())

  targetUser   User  @relation("UserAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  author       User? @relation("UserAuditAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? 
  session_state     String?

  user              User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model InviteToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique @default(uuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ─── MAIN DOMAIN ─────────────────────────────────────────────────────────────

model ClientApplication {
  id              String            @id @default(uuid())
  userId          String            @unique
  clientType      String
  applicationData Json              @default("{}")
  adminOverrides  Json              @default("{}")
  status          ApplicationStatus @default(DRAFT)
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Booking {
  id                    String        @id @default(uuid())
  userId                String
  startDate             DateTime
  endDate               DateTime
  totalAmount           Float
  status                BookingStatus @default(PENDING_REVIEW)
  totalReplacementValue Float?        @default(0)
  insuranceIncluded     Boolean?      @default(true)
  cancellationReason    String?
  cancelledAt           DateTime?
  expiredAt             DateTime?
  promoCode             String?
  discountAmount        Float?        @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingItems          BookingItem[]
  auditLogs             BookingAuditLog[]
  labels                BookingLabel[]

  balanceTransactions   BalanceTransaction[]
  generatedDocuments    DocumentGenerationLog[]
  payments              BookingPayment[]

  bookingAdminNotes     BookingAdminNote[]
}

model BookingItem {
  id                        String     @id @default(uuid())
  bookingId                 String
  equipmentId               String
  priceAtBooking            Float
  depositAtBooking          Float?     @default(0)
  replacementValueAtBooking Float?     @default(0)
  booking                   Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  equipment                 Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
}

model BookingAuditLog {
  id          String   @id @default(uuid())
  bookingId   String
  authorId    String?
  authorName  String?
  action      String
  fieldName   String?
  valueBefore String?  @db.Text
  valueAfter  String?  @db.Text
  meta        Json?
  createdAt   DateTime @default(now())

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author      User?   @relation("AuditAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model BookingLabel {
  id             String    @id @default(uuid())
  bookingId      String
  authorId       String?
  text           String
  color          String    @default("amber")
  dueDate        DateTime?
  shift          String?
  createdAt      DateTime  @default(now())

  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author         User?   @relation("LabelAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model BalanceTransaction {
  id          String        @id @default(uuid())
  userId      String
  bookingId   String?
  type        BalanceTxType
  amount      Float
  description String?       @db.Text
  authorId    String?
  createdAt   DateTime      @default(now())

  user        User          @relation("UserBalance", fields: [userId], references: [id], onDelete: Cascade)
  booking     Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  author      User?         @relation("TxAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model BookingAdminNote {
  id        String   @id @default(uuid())
  bookingId String
  authorId  String?
  note      String   @db.Text
  createdAt DateTime @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author    User?   @relation("BookingNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}
// ─── BOOKING PAYMENTS ────────────────────────────────────────────────────────

model BookingPayment {
  id          String        @id @default(uuid())
  bookingId   String
  authorId    String?
  amount      Float                           // Сумма платежа (всегда > 0)
  method      PaymentMethod @default(CASH)    // Способ оплаты
  note        String?       @db.Text          // Произвольный комментарий
  paidAt      DateTime      @default(now())   // Фактическая дата/время оплаты
  createdAt   DateTime      @default(now()) 
  type        PaymentType   @default(PAYMENT) // Тип платежа

  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author      User?         @relation("PaymentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model Equipment {
  id                       String          @id @default(uuid())
  title                    String
  slug                     String          @unique
  description              String?         @db.Text
  pricePerDay              Float
  price4h                  Float           @default(0)
  price8h                  Float           @default(0)
  deposit                  Float           @default(0)
  replacementValue         Float           @default(0)

  categoryId               String          
  subcategoryId            String?         
  
  isAvailable              Boolean         @default(true)
  isPrimary                Boolean         @default(false)
  isFeatured               Boolean         @default(false)
  priceStudio              Float           @default(0)
  studioAvailable          Boolean         @default(true)
  status                   EquipmentStatus @default(AVAILABLE)
  inventoryNumber          String?
  defects                  String?         @db.Text
  kit                      String?         @db.Text
  kitDescription           String?         @db.Text
  ownershipType            OwnershipType   @default(INTERNAL)
  partnerName              String?
  specifications           Json            @default("{}")
  comments                 Json            @default("[]")
  videoUrls                Json            @default("[]")
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  category                 Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory              Subcategory?    @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  relatedEquipment         EquipmentRelation[] @relation("EquipmentToRelated")
  relatedTo                EquipmentRelation[] @relation("RelatedToEquipment")

  bookingItems             BookingItem[]
  cartItems                CartItem[]
  favorites                Favorite[]
  equipmentImageLinks      EquipmentImageLink[]
  studioBookingItems       StudioBookingItem[]

  promoRestrictions        PromoCodeEquipment[]
}

model EquipmentRelation {
  id          String @id @default(uuid())
  equipmentId String
  relatedId   String

  equipment   Equipment @relation("EquipmentToRelated", fields: [equipmentId], references: [id], onDelete: Cascade)
  related     Equipment @relation("RelatedToEquipment", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, relatedId])
}

model Category {
  id            String  @id @default(uuid())
  name          String
  slug          String  @unique
  iconName      String  @default("Package")
  sortOrder     Int     @default(0)
  adminNotes    String?
  imageUrl      String?
  isModular     Boolean @default(false)

  subcategories Subcategory[]
  equipments    Equipment[]
}

model Subcategory {
  id         String  @id @default(uuid())
  categoryId String
  name       String
  slug       String  @unique
  sortOrder  Int     @default(0)
  adminNotes String?
  imageUrl   String?

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  equipments Equipment[]
}

model Image {
  id   String  @id @default(uuid())
  url  String
  hash String? @unique

  equipmentImageLinks EquipmentImageLink[]
}

model EquipmentImageLink {
  id          String @id @default(uuid())
  equipmentId String
  imageId     String
  orderIndex  Int    @default(0)

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  image       Image     @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, imageId])
}

model CartItem {
  id                String    @id @default(uuid())
  userId            String
  equipmentId       String
  quantity          Int       @default(1)
  addedAt           DateTime  @default(now())
  bookedAt          DateTime?
  prepaidAt         DateTime?
  fullyPaidAt       DateTime?
  depositPaidAt     DateTime?
  depositReturnedAt DateTime?
  depositAmount     Float?    @default(0)
  completedAt       DateTime?
  cancelledAt       DateTime?
  changeLog         Json      @default("[]")

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment         Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  @@unique([userId, equipmentId])
}

model Favorite {
  id          String   @id @default(uuid())
  userId      String
  equipmentId String   
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model EquipmentSet {
  id               String   @id @default(uuid())
  userId           String
  name             String
  description      String?  @db.Text
  items            Json     @default("[]")
  totalPricePerDay Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminNotification {
  id         String   @id @default(uuid())
  type       String   
  userId     String?  // клиент, который совершил действие
  entityId   String?  // id заказа / треда / анкеты / faqQuestion
  entityType String?  // "booking" | "studioBooking" | "application" | "supportThread" | "faqQuestion" | "user"
  payload    Json     @default("{}")
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CategoryHistory {
  id         String             @id @default(uuid())
  entityType CategoryEntityType
  entityId   String             
  action     HistoryAction
  changedBy  String?
  changes    Json?
  changedAt  DateTime           @default(now())

  user       User? @relation(fields: [changedBy], references: [id], onDelete: SetNull)
}

model FaqItem {
  id         String   @id @default(uuid())
  question   String   @db.Text
  answer     String   @db.Text
  sortOrder  Int      @default(0)
  category   String?
  tags      String[] @default([])
  isActive   Boolean  @default(true)
  createdBy  String?
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author  User? @relation("FaqCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater User? @relation("FaqUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model FaqQuestion {
  id        String   @id @default(cuid())
  text      String
  email     String?
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Banner {
  id         String    @id @default(uuid())
  title      String
  subtitle   String?
  body       String?   @db.Text
  imageUrl   String?
  videoUrl   String?                        // URL видео (S3 или YouTube/внешний)
  linkUrl    String?
  linkLabel  String?
  type       String    @default("info")
  placement  String    @default("both")     // "hero" | "studio" | "both"
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  eventDate  DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  creator    User? @relation("BannerCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  images     BannerImage[]
}

model BannerImage {
  id         String   @id @default(uuid())
  bannerId   String
  url        String                         // URL фото или видео в S3
  videoUrl   String?                        // если заполнено — элемент является видео
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  banner     Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
}


model UserAdminNote {
  id        String   @id @default(uuid())
  userId    String
  authorId  String?
  note      String   @db.Text
  createdAt DateTime @default(now())

  targetUser User  @relation("NoteTarget", fields: [userId], references: [id], onDelete: Cascade)
  author     User? @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model UserDiscount {
  id          String       @id @default(uuid())
  userId      String
  type        DiscountType
  value       Float        @default(0)
  promoCode   String?
  description String?      @db.Text
  validFrom   DateTime?
  validUntil  DateTime?
  isActive    Boolean      @default(true)
  createdBy   String?
  createdAt   DateTime     @default(now())

  user        User  @relation("DiscountUser", fields: [userId], references: [id], onDelete: Cascade)
  creator     User? @relation("DiscountCreator", fields: [createdBy], references: [id], onDelete: SetNull)
}

model DocumentTemplate {
  id                 String               @id @default(uuid())
  name               String               // "Договор аренды физ. лицо"
  type               DocumentTemplateType
  fileUrl            String               // S3 URL загруженного шаблона
  fileFormat         String               // "docx" | "xlsx" | "pdf"
  variables          Json                 @default("[]")  // список доступных переменных
  description        String?
  isActive           Boolean              @default(true)
  sortOrder          Int                  @default(0)
  createdBy          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  creator            User?                  @relation("TemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  generationLogs     DocumentGenerationLog[]
}

model DocumentGenerationLog {
  id               String           @id @default(uuid())
  bookingId        String
  templateId       String
  generatedUrl     String   // S3 URL сгенерированного документа
  generatedBy      String?
  createdAt        DateTime         @default(now())

  booking          Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  template         DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  author           User?            @relation("DocGenAuthor", fields: [generatedBy], references: [id], onDelete: SetNull)
}

// ─── PROMO CODES ─────────────────────────────────────────────────────────────

model PromoCode {
  id                      String       @id @default(uuid())
  code                    String       @unique
  type                    DiscountType
  value                   Float
  description             String?      @db.Text
  isActive                Boolean      @default(true)
  usageLimit              Int?
  usedCount               Int          @default(0)
  perUserLimit            Int?                              // лимит на одного клиента (null = без ограничений)
  minOrderAmount          Float?                            // минимальная сумма заказа
  autoApplyTrigger        String?                           // "FIRST_BOOKING_AFTER_APPROVAL" | null
  validFrom               DateTime?
  validUntil              DateTime?
  createdBy               String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  creator                 User?                   @relation("PromoCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  equipmentRestrictions   PromoCodeEquipment[]   //
}

model PromoCodeEquipment {
  promoCodeId  String
  equipmentId  String

  promoCode    PromoCode  @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  equipment    Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, equipmentId])
}

// ─── STUDIO ──────────────────────────────────────────────────────────────────

// Тариф студии (база, интервью, хромакей и кастомные)
model StudioTariff {
  id          String   @id @default(uuid())
  name        String                          // "База", "Интервью", "Хромакей"
  description String?  @db.Text               // Описание тарифа
  details     String?  @db.Text               // Детализация (что входит)
  pricePerHour Float                          // Стоимость за час
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  imageUrls   Json     @default("[]")         // Массив URL фотографий
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studioBookings StudioBooking[]
}

// Заказ аренды студии
model StudioBooking {
  id                 String        @id @default(uuid())
  userId             String
  tariffId           String
  startDate          DateTime
  endDate            DateTime
  durationHours      Float                              // Расчётная длительность в часах
  tariffPriceAtBooking Float                            // Цена тарифа на момент бронирования
  totalAmount        Float                              // Итоговая сумма (тариф + техника)
  status             BookingStatus @default(PENDING_REVIEW)
  cancellationReason String?
  cancelledAt        DateTime?
  expiredAt          DateTime?
  promoCode          String?
  discountAmount     Float?        @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tariff             StudioTariff @relation(fields: [tariffId], references: [id], onDelete: Restrict)

  items              StudioBookingItem[]
  auditLogs          StudioBookingAuditLog[]
  payments           StudioBookingPayment[]
}

// Дополнительная техника в заказе студии
model StudioBookingItem {
  id                  String        @id @default(uuid())
  studioBookingId     String
  equipmentId         String
  priceAtBooking      Float                              // priceStudio на момент бронирования

  studioBooking StudioBooking @relation(fields: [studioBookingId], references: [id], onDelete: Cascade)
  equipment     Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
}

// Платежи по заказу студии (идентичны BookingPayment)
model StudioBookingPayment {
  id              String        @id @default(uuid())
  studioBookingId String
  authorId        String?
  amount          Float
  method          PaymentMethod @default(CASH)
  note            String?       @db.Text
  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())
  type            PaymentType   @default(PAYMENT)

  studioBooking StudioBooking @relation(fields: [studioBookingId], references: [id], onDelete: Cascade)
  author        User?         @relation("StudioPaymentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model StudioBookingAuditLog {
  id              String   @id @default(uuid())
  studioBookingId String
  authorId        String?
  authorName      String?
  action          String
  fieldName       String?
  valueBefore     String?  @db.Text
  valueAfter      String?  @db.Text
  meta            Json?
  createdAt       DateTime @default(now())

  studioBooking StudioBooking @relation(fields: [studioBookingId], references: [id], onDelete: Cascade)
  author        User?         @relation("StudioAuditAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model AboutPageSettings {
  id          String   @id @default("default")
  heroTitle   String   @default("LINZA")
  heroSub     String   @default("Это не просто прокат и студия.")
  description String   @default("Мы предоставляем передовое фото- и видеооборудование для профессионалов и любителей в Самаре. Наш приоритет — качество техники и безупречный сервис.")
  imageUrl    String?  @map("imageUrl")
  updatedAt   DateTime @updatedAt @map("updatedAt")

  @@map("about_page_settings")
}

// ─── SUPPORT CHAT ──────────────────────────────────────────────────

model SupportThread {
  id                String              @id @default(uuid())
  userId            String
  subject           String
  platform          SupportPlatform     @default(WEBSITE)
  status            SupportThreadStatus @default(OPEN)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lastMessageAt     DateTime            @default(now())
  contactInfo       String?             // email / telegram / phone клиента
  clientReadAt      DateTime?           // когда клиент последний раз читал тред
  deletedByClientAt DateTime?           // мягкое удаление клиентом
  deletedByAdminAt  DateTime?           // мягкое удаление админом

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          SupportMessage[]
}

model SupportMessage {
  id                String                @id @default(uuid())
  threadId          String
  authorId          String
  isAdmin           Boolean               @default(false)
  content           String                @db.Text
  createdAt         DateTime              @default(now())
  isEdited          Boolean   @default(false)
  editedAt          DateTime?

  thread            SupportThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author            User                  @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  readBy            SupportMessageRead[]
}

model SupportMessageRead {
  id                String                @id @default(uuid())
  messageId         String
  adminId           String
  readAt            DateTime              @default(now())

  message           SupportMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  admin             User                  @relation("SupportMessageReader", fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([messageId, adminId])
}